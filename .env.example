# Copie este archivo como .env (NO lo suba a GitHub). Solo valores de desarrollo.
# Conexión a PostgreSQL. Si ejecuta la API en su equipo contra la base del reto ETL (docker 5432):
DATABASE_URL=postgresql+psycopg2://reto:reto@localhost:5432/retoetl
# Umbrales ORIGINALES de la regla de decisión (los mismos que usó en el notebook del ETL):
ORIG_MIN_ESTRELLAS=3
ORIG_MIN_EDICIONES=5
ORIG_TOP_K=10
